# dependencies
/node_modules
/.pnp
.pnp.js

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# typescript
*.tsbuildinfo
next-env.d.ts.timestamp

# env
.env*.local

# 로컬 작업 폴더 (업로드된 영상 / 렌더링 결과 / B-roll 소스)
/storage/uploads/*
!/storage/uploads/.gitkeep
/storage/output/*
!/storage/output/.gitkeep

# B-roll: 카테고리 폴더 구조와 .gitkeep 은 유지하고, 실제 미디어 파일만 무시
/storage/broll/**/*.mp4
/storage/broll/**/*.mov
/storage/broll/**/*.webm
/storage/broll/**/*.mkv
/storage/broll/**/*.m4v
